{
  "schema": "uw-evaluation-profile/v1",
  "module": "climate",
  "description": "Earth climate on imported terrain (earth-climate recipe). Validation against ERA5, IMERG, OISST and GLORYS is the primary evidence; the user's visual review overrides the numerical recommendation. Moisture, precipitation-rate and ocean fields are diagnostics of the run on the solvers' own grids, so a bundle needs the run that made it in the same process (a copied or reloaded world has none).",
  "evidence": {"checks": "required", "validation": "primary", "review": "override"},
  "run": {"tool": "world_pipeline", "resolution": 512,
          "arguments": ["run", "--recipe", "earth-climate", "--import-land", "refs/processed/land_ocean/maps/earth_land_{width}x{height}.tif",
                        "--import-sea", "refs/processed/land_ocean/maps/earth_sea_{width}x{height}.tif",
                        "--resolution", "{width}", "--map", "none"],
          "inputs": [{"environment": "UW_CLIMATE_SURFACE_DRAG_INPUT", "derive": "drag-contrast",
                      "source": "refs/processed/era5-vegetation-drag/1024/land-drag-contrast-1024.txt"}],
          "registered": {"resolution": 1024,
                         "arguments": ["--climate-resolution", "128", "--climate-hydrology-resolution", "256",
                                       "--climate-coupling-iterations", "8"]}},
  "checks": [
    {"check": "grid"},
    {"check": "required",
     "fields": ["atmosphere.temperature", "atmosphere.solver_monthly_temperature", "atmosphere.precipitation_exact",
                "atmosphere.pressure", "atmosphere.level_wind_east", "atmosphere.level_wind_north",
                "atmosphere.level_available", "hydrosphere.solver_sea_surface_temperature", "cryosphere.solver_sea_ice",
                "geosphere.base_elevation", "geosphere.sea_level", "atmosphere.column_water",
                "atmosphere.moisture_transport_east", "atmosphere.moisture_transport_north",
                "atmosphere.moisture_convergence", "atmosphere.precipitation_rate", "hydrosphere.current_east",
                "hydrosphere.current_north", "hydrosphere.mixed_layer_temperature"],
     "tables": ["atmosphere.levels"]},
    {"check": "written", "fields": ["atmosphere.temperature", "atmosphere.precipitation_exact", "atmosphere.pressure",
                                    "atmosphere.level_wind_east", "hydrosphere.solver_sea_surface_temperature"]},
    {"check": "finite", "fields": ["atmosphere.*", "hydrosphere.solver_*", "cryosphere.solver_*"]},
    {"check": "range", "field": "atmosphere.solver_monthly_temperature", "min": -95, "max": 60},
    {"check": "range", "field": "atmosphere.precipitation_exact", "min": 0, "max": 3000, "report": true},
    {"check": "range", "field": "atmosphere.pressure", "min": -80, "max": 80},
    {"check": "range", "field": "atmosphere.level_wind_east", "min": -120, "max": 120},
    {"check": "range", "field": "atmosphere.level_wind_north", "min": -120, "max": 120},
    {"check": "range", "field": "hydrosphere.solver_sea_surface_temperature", "mask": "sea", "min": -2, "max": 36},
    {"check": "range", "field": "cryosphere.solver_sea_ice", "min": 0, "max": 1, "tolerance": 1e-5},
    {"check": "range", "field": "atmosphere.column_water", "min": 0, "max": 120, "report": true},
    {"check": "range", "field": "atmosphere.precipitation_rate", "min": 0, "max": 200},
    {"check": "range", "field": "hydrosphere.current_east", "min": -5, "max": 5},
    {"check": "range", "field": "hydrosphere.current_north", "min": -5, "max": 5},
    {"check": "frozen", "components": ["geosphere"]},
    {"check": "repeat"}
  ],
  "validation": [
    {"id": "surface_wind", "kind": "vector", "season": "month",
     "model": ["atmosphere.level_wind_east[0]", "atmosphere.level_wind_north[0]"], "reference": ["era5_u10m", "era5_v10m"]},
    {"id": "850_wind", "kind": "vector", "season": "month", "mask": {"field": "atmosphere.level_available[1]"},
     "model": ["atmosphere.level_wind_east[1]", "atmosphere.level_wind_north[1]"], "reference": ["era5_u850", "era5_v850"]},
    {"id": "500_wind", "kind": "vector", "season": "month",
     "model": ["atmosphere.level_wind_east[2]", "atmosphere.level_wind_north[2]"], "reference": ["era5_u500", "era5_v500"]},
    {"id": "pressure", "kind": "scalar", "season": "month", "transform": ["remove-area-mean"],
     "model": ["atmosphere.pressure"], "reference": ["era5_slp_anom"]},
    {"id": "rain", "kind": "scalar", "season": "quarter",
     "model": ["atmosphere.precipitation_rate"], "reference": ["era5_pr"]},
    {"id": "annual_rain", "kind": "scalar", "season": "annual", "reduce": "season-mean", "scale": 12,
     "model": ["atmosphere.precipitation_exact"], "reference": ["imerg_prec_annual"]},
    {"id": "water", "kind": "scalar", "season": "quarter",
     "model": ["atmosphere.column_water"], "reference": ["era5_tcwv"]},
    {"id": "moisture_flux", "kind": "vector", "season": "quarter",
     "model": ["atmosphere.moisture_transport_east", "atmosphere.moisture_transport_north"], "reference": ["era5_viwve", "era5_viwvn"]},
    {"id": "convergence", "kind": "scalar", "season": "quarter",
     "model": ["atmosphere.moisture_convergence"], "reference": ["era5_vimd"]},
    {"id": "sst_oisst", "kind": "scalar", "season": "quarter", "mask": "sea",
     "model": ["hydrosphere.mixed_layer_temperature"], "reference": ["oisst_sst"]},
    {"id": "current", "kind": "vector", "season": "quarter", "mask": "sea",
     "model": ["hydrosphere.current_east", "hydrosphere.current_north"], "reference": ["glorys_uo", "glorys_vo"]},
    {"id": "air_temperature", "kind": "scalar", "season": "quarter",
     "model": ["atmosphere.solver_monthly_temperature"], "reference": ["era5_t2m"]},
    {"id": "850_wind_generic", "metric_scale": "850_wind", "kind": "vector", "season": "month",
     "mask": {"field": "atmosphere.level_available[1]"},
     "model": ["atmosphere.level_wind_east[@generic-850hPa]", "atmosphere.level_wind_north[@generic-850hPa]"],
     "reference": ["era5_u850", "era5_v850"]}
  ],
  "maps": [
    {"name": "temperature", "validation": "air_temperature", "title": "Air temperature (°C)", "field": "atmosphere.temperature", "palette": "climate:air_temperature", "seasons": [0, 2]},
    {"name": "annual-rain", "validation": "annual_rain", "title": "Annual precipitation (mm/yr)", "field": "atmosphere.precipitation_exact", "reduce": "season-mean", "scale": 12, "palette": "climate:annual_rain"},
    {"name": "pressure", "validation": "pressure", "title": "Surface pressure anomaly (hPa)", "field": "atmosphere.pressure", "palette": "climate:pressure", "seasons": [0, 2]},
    {"name": "surface-wind", "validation": "surface_wind", "title": "10 m wind speed (m/s)", "vector": ["atmosphere.level_wind_east[0]", "atmosphere.level_wind_north[0]"], "palette": "climate:surface_wind", "seasons": [0, 2]},
    {"name": "wind-850", "validation": "850_wind", "title": "850 hPa wind speed (m/s)", "vector": ["atmosphere.level_wind_east[1]", "atmosphere.level_wind_north[1]"], "palette": "climate:850_wind", "seasons": [0, 2]},
    {"name": "wind-500", "validation": "500_wind", "title": "500 hPa wind speed (m/s)", "vector": ["atmosphere.level_wind_east[2]", "atmosphere.level_wind_north[2]"], "palette": "climate:500_wind", "seasons": [0, 2]},
    {"name": "sst", "validation": "sst_oisst", "title": "Sea surface temperature (°C)", "field": "hydrosphere.solver_sea_surface_temperature", "mask": "sea", "palette": "climate:sst", "seasons": [0, 2]},
    {"name": "rain", "validation": "rain", "title": "Precipitation rate (mm/day)", "field": "atmosphere.precipitation_rate", "palette": "climate:rain", "seasons": [0, 2]},
    {"name": "column-water", "validation": "water", "title": "Column water (mm), process grid", "field": "atmosphere.column_water", "palette": "climate:water", "seasons": [0, 2]},
    {"name": "moisture-flux", "validation": "moisture_flux", "title": "Column moisture transport (kg/(m s)), process grid", "vector": ["atmosphere.moisture_transport_east", "atmosphere.moisture_transport_north"], "palette": "climate:moisture_flux", "seasons": [0, 2]},
    {"name": "convergence", "validation": "convergence", "title": "Moisture convergence (mm/day), process grid", "field": "atmosphere.moisture_convergence", "palette": "climate:convergence", "seasons": [0, 2]},
    {"name": "currents", "validation": "current", "title": "Ocean current speed (m/s), ocean grid", "vector": ["hydrosphere.current_east", "hydrosphere.current_north"], "mask": "sea", "palette": "climate:current", "seasons": [0, 2]}
  ],
  "review": [
    {"id": "itcz-single-band", "question": "Is the tropical rain maximum a single band in each ocean, placed as in the reference in both seasons?", "maps": ["rain", "convergence"], "seasons": "all", "region": "tropics", "good": "one band 5 to 10 degrees wide; north of the equator all year in the eastern Pacific and the Atlantic, moving south of it in January over the Indian Ocean and the western Pacific; no second band across the whole Pacific that the reference lacks", "severity": "blocker"},
    {"id": "subtropical-dry-belts", "question": "Are the subtropical deserts dry and in the right places?", "maps": ["annual-rain"], "seasons": "all", "region": "subtropics", "good": "under 250 mm/yr over the Sahara, Arabia, central Australia, the Kalahari and Namib, the Atacama and the south-west of North America", "severity": "major"},
    {"id": "monsoon-reversal", "question": "Do South Asia and West Africa get their rain in the northern summer, with onshore surface wind then and offshore wind in January?", "maps": ["rain", "surface-wind", "moisture-flux"], "seasons": "all", "region": "monsoon regions", "good": "wet July and dry January over India, the Bay of Bengal coast and the Sahel; wind direction reverses over the Arabian Sea", "severity": "major"},
    {"id": "orographic-rain", "question": "Is rain heavier on the windward side of the large ranges and lighter in their lee?", "maps": ["annual-rain", "rain"], "seasons": "all", "region": "mountains", "good": "wet western slopes of the southern Andes and the Pacific Northwest, wet southern slope of the Himalaya, dry Patagonia and Tibetan Plateau", "severity": "major"},
    {"id": "surface-wind-belts", "question": "Are there easterly trades in the tropics and westerlies at 40 to 60 degrees in both hemispheres, strongest over the Southern Ocean?", "maps": ["surface-wind"], "seasons": "all", "region": "global", "good": "speed maxima over the Southern Ocean and the winter North Atlantic and North Pacific; weak wind along the equator and under the subtropical highs", "severity": "blocker"},
    {"id": "jets-500", "question": "Is there one 500 hPa westerly maximum per hemisphere at 30 to 50 degrees, stronger in the winter hemisphere?", "maps": ["wind-500", "wind-850"], "seasons": "all", "region": "mid-latitudes", "good": "continuous band around each hemisphere; no blocks at the size of solver cells over high terrain", "severity": "major"},
    {"id": "pressure-centres", "question": "Are the semi-permanent pressure centres present and placed as observed?", "maps": ["pressure"], "seasons": "all", "region": "global", "good": "January: Aleutian and Icelandic lows, Siberian high. July: North Pacific and Azores highs, low over South Asia. Southern subtropical highs over each ocean all year", "severity": "major"},
    {"id": "sst-pattern", "question": "Does sea surface temperature show the warm pool, the eastern cold tongues and the poleward gradient without land-shaped or blocky patches?", "maps": ["sst"], "seasons": "all", "region": "oceans", "good": "warmest water in the western Pacific and Indian Ocean; cooler eastern equatorial Pacific and Atlantic; cold currents along the west coasts of the Americas and Africa", "severity": "major"},
    {"id": "ocean-gyres", "question": "Do the currents form subtropical gyres with fast western boundary currents and a continuous circumpolar current?", "maps": ["currents"], "seasons": "all", "region": "oceans", "good": "Gulf Stream and Kuroshio visible as narrow fast bands; Antarctic Circumpolar Current unbroken through Drake Passage; equatorial currents westward", "severity": "major"},
    {"id": "temperature-seasons", "question": "Is the seasonal temperature range larger over the northern continents than over the oceans, with smooth gradients?", "maps": ["temperature"], "seasons": "all", "region": "global", "good": "Siberia and Canada far colder in January than the oceans at the same latitude; no steps of one unit, no coast-following lines", "severity": "major"},
    {"id": "moisture", "question": "Is column water highest over the warm pool and the rain band and lowest over the poles, deserts and high plateaus?", "maps": ["column-water", "moisture-flux"], "seasons": "all", "region": "global", "good": "smooth tropical maximum following the rain band; dry Sahara, Tibet, Antarctica and Greenland", "severity": "minor"},
    {"id": "grid-artefacts", "question": "Are all maps free of structures that follow the grid?", "maps": ["rain", "annual-rain", "column-water", "convergence", "surface-wind", "wind-850", "temperature", "pressure"], "seasons": "all", "region": "global", "good": "no straight line along a latitude row or a meridian, no single-cell hotspot at a pole, no staircase blocks at solver-cell size, no sharp line along a coast (Antarctica)", "severity": "major"}
  ]
}
