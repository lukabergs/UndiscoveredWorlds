{
  "schema": "uw-evaluation-profile/v1",
  "module": "climate",
  "description": "Earth climate on imported terrain (earth-climate recipe). Validation against ERA5, IMERG, OISST and GLORYS is the primary evidence; the user's visual review overrides the numerical recommendation. Moisture, precipitation-rate and ocean fields are diagnostics of the run on the solvers' own grids, so a bundle needs the run that made it in the same process (a copied or reloaded world has none).",
  "evidence": {"checks": "required", "validation": "primary", "review": "override"},
  "run": {"tool": "world_pipeline", "resolution": 512,
          "arguments": ["run", "--recipe", "earth-climate", "--import-land", "refs/processed/land_ocean/maps/earth_land_{width}x{height}.tif",
                        "--import-sea", "refs/processed/land_ocean/maps/earth_sea_{width}x{height}.tif",
                        "--resolution", "{width}", "--map", "none"]},
  "checks": [
    {"check": "grid"},
    {"check": "required",
     "fields": ["atmosphere.temperature", "atmosphere.solver_monthly_temperature", "atmosphere.precipitation_exact",
                "atmosphere.pressure", "atmosphere.level_wind_east", "atmosphere.level_wind_north",
                "atmosphere.level_available", "hydrosphere.solver_sea_surface_temperature", "cryosphere.solver_sea_ice",
                "geosphere.base_elevation", "geosphere.sea_level", "atmosphere.column_water",
                "atmosphere.moisture_transport_east", "atmosphere.moisture_transport_north",
                "atmosphere.moisture_convergence", "atmosphere.precipitation_rate", "hydrosphere.current_east",
                "hydrosphere.current_north", "hydrosphere.mixed_layer_temperature"],
     "tables": ["atmosphere.levels"]},
    {"check": "written", "fields": ["atmosphere.temperature", "atmosphere.precipitation_exact", "atmosphere.pressure",
                                    "atmosphere.level_wind_east", "hydrosphere.solver_sea_surface_temperature"]},
    {"check": "finite", "fields": ["atmosphere.*", "hydrosphere.solver_*", "cryosphere.solver_*"]},
    {"check": "range", "field": "atmosphere.solver_monthly_temperature", "min": -95, "max": 60},
    {"check": "range", "field": "atmosphere.precipitation_exact", "min": 0, "max": 3000},
    {"check": "range", "field": "atmosphere.pressure", "min": -80, "max": 80},
    {"check": "range", "field": "atmosphere.level_wind_east", "min": -120, "max": 120},
    {"check": "range", "field": "atmosphere.level_wind_north", "min": -120, "max": 120},
    {"check": "range", "field": "hydrosphere.solver_sea_surface_temperature", "mask": "sea", "min": -2, "max": 36},
    {"check": "range", "field": "cryosphere.solver_sea_ice", "min": 0, "max": 1, "tolerance": 1e-5},
    {"check": "range", "field": "atmosphere.column_water", "min": 0, "max": 120},
    {"check": "range", "field": "atmosphere.precipitation_rate", "min": 0, "max": 200},
    {"check": "range", "field": "hydrosphere.current_east", "min": -5, "max": 5},
    {"check": "range", "field": "hydrosphere.current_north", "min": -5, "max": 5},
    {"check": "frozen", "components": ["geosphere"]},
    {"check": "repeat"}
  ],
  "validation": [
    {"id": "surface_wind", "kind": "vector", "season": "month",
     "model": ["atmosphere.level_wind_east[0]", "atmosphere.level_wind_north[0]"], "reference": ["era5_u10m", "era5_v10m"]},
    {"id": "850_wind", "kind": "vector", "season": "month", "mask": {"field": "atmosphere.level_available[1]"},
     "model": ["atmosphere.level_wind_east[1]", "atmosphere.level_wind_north[1]"], "reference": ["era5_u850", "era5_v850"]},
    {"id": "500_wind", "kind": "vector", "season": "month",
     "model": ["atmosphere.level_wind_east[2]", "atmosphere.level_wind_north[2]"], "reference": ["era5_u500", "era5_v500"]},
    {"id": "pressure", "kind": "scalar", "season": "month", "transform": ["remove-area-mean"],
     "model": ["atmosphere.pressure"], "reference": ["era5_slp_anom"]},
    {"id": "rain", "kind": "scalar", "season": "quarter",
     "model": ["atmosphere.precipitation_rate"], "reference": ["era5_pr"]},
    {"id": "annual_rain", "kind": "scalar", "season": "annual", "reduce": "season-mean", "scale": 12,
     "model": ["atmosphere.precipitation_exact"], "reference": ["imerg_prec_annual"]},
    {"id": "water", "kind": "scalar", "season": "quarter",
     "model": ["atmosphere.column_water"], "reference": ["era5_tcwv"]},
    {"id": "moisture_flux", "kind": "vector", "season": "quarter",
     "model": ["atmosphere.moisture_transport_east", "atmosphere.moisture_transport_north"], "reference": ["era5_viwve", "era5_viwvn"]},
    {"id": "convergence", "kind": "scalar", "season": "quarter",
     "model": ["atmosphere.moisture_convergence"], "reference": ["era5_vimd"]},
    {"id": "sst_oisst", "kind": "scalar", "season": "quarter", "mask": "sea",
     "model": ["hydrosphere.mixed_layer_temperature"], "reference": ["oisst_sst"]},
    {"id": "current", "kind": "vector", "season": "quarter", "mask": "sea",
     "model": ["hydrosphere.current_east", "hydrosphere.current_north"], "reference": ["glorys_uo", "glorys_vo"]},
    {"id": "air_temperature", "kind": "scalar", "season": "quarter",
     "model": ["atmosphere.solver_monthly_temperature"], "reference": ["era5_t2m"]},
    {"id": "850_wind_generic", "metric_scale": "850_wind", "kind": "vector", "season": "month",
     "mask": {"field": "atmosphere.level_available[1]"},
     "model": ["atmosphere.level_wind_east[@generic-850hPa]", "atmosphere.level_wind_north[@generic-850hPa]"],
     "reference": ["era5_u850", "era5_v850"]}
  ],
  "maps": [
    {"name": "temperature", "title": "Air temperature (°C)", "field": "atmosphere.temperature", "palette": "climate:air_temperature", "seasons": [0, 2]},
    {"name": "annual-rain", "title": "Annual precipitation (mm/yr)", "field": "atmosphere.precipitation_exact", "reduce": "season-mean", "scale": 12, "palette": "climate:annual_rain"},
    {"name": "pressure", "title": "Surface pressure anomaly (hPa)", "field": "atmosphere.pressure", "palette": "climate:pressure", "seasons": [0, 2]},
    {"name": "surface-wind", "title": "10 m wind speed (m/s)", "vector": ["atmosphere.level_wind_east[0]", "atmosphere.level_wind_north[0]"], "palette": "climate:surface_wind", "seasons": [0, 2]},
    {"name": "wind-850", "title": "850 hPa wind speed (m/s)", "vector": ["atmosphere.level_wind_east[1]", "atmosphere.level_wind_north[1]"], "palette": "climate:850_wind", "seasons": [0, 2]},
    {"name": "wind-500", "title": "500 hPa wind speed (m/s)", "vector": ["atmosphere.level_wind_east[2]", "atmosphere.level_wind_north[2]"], "palette": "climate:500_wind", "seasons": [0, 2]},
    {"name": "sst", "title": "Sea surface temperature (°C)", "field": "hydrosphere.solver_sea_surface_temperature", "mask": "sea", "palette": "climate:sst", "seasons": [0, 2]},
    {"name": "column-water", "title": "Column water (mm), process grid", "field": "atmosphere.column_water", "palette": "climate:water", "seasons": [0, 2]},
    {"name": "moisture-flux", "title": "Column moisture transport (kg/(m s)), process grid", "vector": ["atmosphere.moisture_transport_east", "atmosphere.moisture_transport_north"], "palette": "climate:moisture_flux", "seasons": [0, 2]},
    {"name": "convergence", "title": "Moisture convergence (mm/day), process grid", "field": "atmosphere.moisture_convergence", "palette": "climate:convergence", "seasons": [0, 2]},
    {"name": "currents", "title": "Ocean current speed (m/s), ocean grid", "vector": ["hydrosphere.current_east", "hydrosphere.current_north"], "mask": "sea", "palette": "climate:current", "seasons": [0, 2]}
  ]
}
