{
  "schema": "uw-evaluation-profile/v1",
  "module": "hydrology",
  "description": "Earth hydrology on imported terrain (earth-hydrology recipe): the earth-climate recipe followed by hydrology.flow_routing, the Geosphere frozen. The largest outlets of the routing are compared with an authored, unchecked table of Earth's river mouths (configs/river-mouths.json), which is context until the user has reviewed it; Earth hypsometry is context for the review. Checks guard drainage, discharge monotonicity and value ranges.",
  "evidence": {"checks": "required", "validation": "context", "review": "primary"},
  "run": {"tool": "world_pipeline", "resolution": 256,
          "arguments": ["run", "--recipe", "earth-hydrology", "--resolution", "{width}",
                        "--import-land", "refs/processed/land_ocean/maps/earth_land_{width}x{height}.tif",
                        "--import-sea", "refs/processed/land_ocean/maps/earth_sea_{width}x{height}.tif",
                        "--climate-resolution", "64", "--climate-coupling-iterations", "2"],
          "inputs": [{"environment": "UW_CLIMATE_SURFACE_DRAG_INPUT", "derive": "drag-contrast",
                      "source": "refs/processed/era5-vegetation-drag/1024/land-drag-contrast-1024.txt"}]},
  "checks": [
    {"check": "grid"},
    {"check": "required", "fields": ["hydrosphere.flow_direction", "hydrosphere.drainage_area", "hydrosphere.discharge", "hydrosphere.filled_elevation", "hydrosphere.depression_id", "planetbody.radius", "geosphere.base_elevation", "geosphere.sea_level"]},
    {"check": "written", "fields": ["hydrosphere.flow_direction", "hydrosphere.drainage_area", "hydrosphere.discharge", "hydrosphere.filled_elevation", "hydrosphere.depression_id"]},
    {"check": "finite", "fields": ["hydrosphere.flow_direction", "hydrosphere.drainage_area", "hydrosphere.discharge", "hydrosphere.filled_elevation", "hydrosphere.depression_id"]},
    {"check": "range", "field": "hydrosphere.discharge", "min": 0},
    {"check": "range", "field": "hydrosphere.drainage_area", "min": 0},
    {"check": "frozen", "components": ["geosphere"]},
    {"check": "drained", "direction": "hydrosphere.flow_direction", "depression": "hydrosphere.depression_id", "elevation": "geosphere.base_elevation", "sea_level": "geosphere.sea_level"},
    {"check": "monotone", "direction": "hydrosphere.flow_direction", "discharge": "hydrosphere.discharge", "elevation": "geosphere.base_elevation", "sea_level": "geosphere.sea_level"}
  ],
  "validation": [
    {"id": "river_mouths", "kind": "river_mouths", "table": "configs/river-mouths.json", "top": 20, "match_km": 500},
    {"id": "hypsometry", "kind": "hypsometry", "reference_width": 2048},
    {"id": "drainage_pattern", "kind": "drainage_pattern"}
  ],
  "maps": [
    {"name": "elevation", "title": "Surface elevation (m)", "derived": "surface_elevation", "palette": "tectonics:elevation"},
    {"name": "discharge", "title": "Discharge (log10 m3/s; dark where there is none)", "field": "hydrosphere.discharge", "transform": "log10", "palette": "tectonics:discharge_log"},
    {"name": "river-mouths", "title": "River mouths: table mouths and the largest outlets over discharge (log10 m3/s)", "field": "hydrosphere.discharge", "transform": "log10", "palette": "tectonics:discharge_log", "overlay": "river_mouths"},
    {"name": "basins", "title": "Drainage basins (outlet folded onto 12 colours; dark at sea)", "derived": "drainage_basin", "hide_zero": true, "palette": "tectonics:category_12"},
    {"name": "annual-rain", "title": "Annual precipitation (mm/yr)", "field": "atmosphere.precipitation", "reduce": "season-mean", "scale": 12, "palette": "climate:annual_rain"}
  ],
  "review_status": "Draft written by an agent on 2026-10-06 (erosion plan, step B5). The user rewrites it; until then a verdict on it is a reading aid, not a judgement of the world.",
  "review": [
    {"id": "largest-outlets-at-mouths", "question": "Do the largest outlets sit at the mouths of Earth's largest rivers?", "maps": ["river-mouths", "discharge", "basins", "annual-rain", "elevation"], "seasons": "all", "region": "coasts", "good": "the highest outlet discharges at or near the mouths of the Amazon, Congo, Ganges-Brahmaputra, Orinoco and Yangtze, with basins of about their shape; no large outlet on a dry coast", "severity": "major"}
  ]
}
