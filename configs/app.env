# Environment-specific app defaults.
# Process environment variables override these values when present.

UW_DEFAULT_WORLD_DIR=.
UW_DEFAULT_UWS_DIR=assets/appearance
UW_DEFAULT_IMAGE_DIR=out/images
UW_TERRAIN_TEMPLATES=assets/terrain/shape-templates.txt
# Tables of the climate solvers written by a run (budgets, coupling, circulation precision).
UW_CLIMATE_DIAGNOSTICS_DIR=out/climate-diagnostics
# Resolution-specific variants are generated by prepare_reduced_earth_benchmark.py.
UW_EARTH_BENCHMARK_LAND=refs/processed/land_ocean/maps/earth_land.tif
UW_EARTH_BENCHMARK_SEA=refs/processed/land_ocean/maps/earth_sea.tif
