# Environment-specific app defaults.
# Process environment variables override these values when present.

UW_DEFAULT_WORLD_DIR=.
UW_DEFAULT_UWS_DIR=assets/appearance
UW_DEFAULT_IMAGE_DIR=out/images
UW_REFERENCE_PRECIP_GRID=refs/processed/climate/earth_precipitation_grid.csv
UW_REFERENCE_CLIMATE_DIR=refs/processed/climate
UW_REFERENCE_PROCESSED_DIR=refs/processed
UW_REFERENCE_CLIMATE_PREVIEW_DIR=refs/processed/climate/previews
UW_CLIMATE_BENCHMARK_RUN_LOG=out/climate-benchmark/registry.json
# The C++ climate-benchmark command and the GUI's "Record climate benchmark" are scratch tools:
# their outputs, including their run log, stay in out/. Registered runs: scripts/uw.py climate run.
# Benchmark previews use category/season/layer/run-number paths.
UW_CLIMATE_BENCHMARK_IMAGE_DIR=out/climate-benchmark/maps
UW_CLIMATE_BENCHMARK_RUN_DIR=out/climate-benchmark/diagnostics
UW_CLIMATE_VALIDATION_DIR=out/climate-benchmark/validation
# Resolution-specific variants are generated by prepare_reduced_earth_benchmark.py.
UW_EARTH_KOPPEN_IMAGE=
UW_EARTH_BENCHMARK_LAND=refs/processed/land_ocean/maps/earth_land.tif
UW_EARTH_BENCHMARK_SEA=refs/processed/land_ocean/maps/earth_sea.tif
