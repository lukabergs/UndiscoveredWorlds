{
    "version": 3,
    "configurePresets": [
        {
            "name": "desktop",
            "generator": "Visual Studio 18 2026",
            "binaryDir": "${sourceDir}/out/build/desktop",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_OVERLAY_PORTS": "${sourceDir}/vcpkg-ports"
            }
        },
        {
            "name": "headless",
            "inherits": "desktop",
            "binaryDir": "${sourceDir}/out/build/headless",
            "cacheVariables": {
                "UW_BUILD_APP": "OFF",
                "BUILD_TESTING": "ON"
            }
        }
    ]
}
