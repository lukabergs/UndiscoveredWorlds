# One checked-in recipe feeds the app and CLI, without runtime path discovery.
set(recipe_path "${PROJECT_SOURCE_DIR}/configs/tectonics-baseline.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${recipe_path}")
file(READ "${recipe_path}" recipe)
set(assignments "// Generated from configs/tectonics-baseline.json; do not edit.\n")
foreach(key seed width height)
    string(JSON value GET "${recipe}" "${key}")
    string(APPEND assignments "scenario.${key} = ${value};\n")
endforeach()
string(JSON count LENGTH "${recipe}" scenario)
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
    string(JSON key MEMBER "${recipe}" scenario ${index})
    string(JSON value GET "${recipe}" scenario "${key}")
    string(REPLACE "-" "_" member "${key}")
    if(key STREQUAL "plates")
        set(member plate_count)
    elseif(key STREQUAL "margin-processes")
        set(member margin_processes.enabled)
    elseif(key MATCHES "^(trench-|flexural-|arc-|river-|sediment-travel-|rift-breakup-|process-|thermal-age-|wave-|root-mobility|sediment-subduction-)")
        set(member "margin_processes.${member}")
    elseif(key STREQUAL "progressive-rifting")
        set(member topology_processes.progressive_rifting)
    elseif(key MATCHES "^rift-(yield|damage-time|strain-rate)")
        string(REGEX REPLACE "^rift_" "" member "${member}")
        set(member "topology_processes.${member}")
    elseif(key MATCHES "^noise-pass-")
        string(REGEX REPLACE "^noise_pass_" "" member "${member}")
        set(member "experimental_noise.${member}")
    elseif(key MATCHES "^plume-")
        string(REGEX REPLACE "^plume_" "" member "${member}")
        set(member "plume_processes.${member}")
    endif()
    if(value STREQUAL "on")
        set(value true)
    elseif(value STREQUAL "off")
        set(value false)
    elseif(NOT value MATCHES "^-?[0-9]+([.][0-9]+)?([eE][+-]?[0-9]+)?$")
        message(FATAL_ERROR "Invalid tectonic recipe value: ${key}=${value}")
    endif()
    string(APPEND assignments "scenario.${member} = static_cast<decltype(scenario.${member})>(${value});\n")
endforeach()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/tectonic_baseline.inc" "${assignments}")
