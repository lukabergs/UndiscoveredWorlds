# Local reference data; retain preparation code and scope notes.
/refs/source/
/refs/processed/
# Retain the human-written map guide; rasters and generated index stay local.
!/refs/processed/
/refs/processed/*
!/refs/processed/climate/
/refs/processed/climate/*
!/refs/processed/climate/maps/
/refs/processed/climate/maps/*
