# Generated results; retain active metadata and selected workbooks.
/runs/*
!/runs/registry/
!/runs/maps/
/runs/maps/*
!/runs/maps/climate/
/runs/maps/climate/*
!/runs/maps/climate/README.md
!/runs/metrics/
/runs/registry/archive/
/runs/metrics/*
!/runs/metrics/metrics.xlsx
!/runs/metrics/run_history.xlsx

